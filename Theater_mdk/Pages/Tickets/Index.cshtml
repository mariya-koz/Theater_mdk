@page
@model Theater_mdk.Pages.Tickets.IndexModel

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">

    <!-- Заголовок и кнопка добавления билета -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список билетов</h2>
        <a asp-page="Create" class="btn btn-success">
            Добавить новый билет
        </a>
    </div>

    <!-- Плитки билетов -->
    <div class="row g-4">
        @foreach (var ticket in Model.Ticket)
        {
            <!-- Каждая карточка билета в колонке -->
            <div class="col-sm-6 col-md-4 col-lg-3">

                <!-- Карточка билета с тенью -->
                <div class="card h-100 shadow-sm" id="ticket-@ticket.Id">
                    <div class="card-body">

                        <!-- Название спектакля с иконкой и обрезкой текста -->
                        <h5 class="card-title text-truncate">
                            📚 @ticket.Title
                        </h5>

                        <!-- Место -->
                        @* <p class="card-text text-muted mb-1">
                            Место: @ticket.Seat
                        </p> *@

                        <p class="card- text-muted mb-1">
                            Время спектакля (в минутах): @ticket.TimeMin
                        </p>

                        <!-- Дата показа -->
                        <p class="card-text mb-1">
                            Дата показа: <span class="badge bg-secondary">@ticket.DataShow</span>
                        </p>

                        <!-- Цена билета -->
                        <p class="card-text mb-2">
                            Цена: <span class="badge bg-info">@ticket.Price</span>
                        </p>

                        <!-- Кнопки действий -->
                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info">
                                Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-warning">
                                Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@ticket.Id" class="btn btn-sm btn-danger">
                                Удалить
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>

</div>
