@page
@model Theater_mdk.Pages.Tickets.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Добавить билет</h4>
                </div>

                <div class="card-body">

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Ticket.Title" class="form-label">Название пьесы</label>
                            <input asp-for="Ticket.Title" class="form-control" />
                            <span asp-validation-for="Ticket.Title" class="text-danger"></span>
                        </div>

                        @* <div class="mb-3">
                            <label asp-for="Ticket.Seat" class="form-label">Место</label>
                            <input asp-for="Ticket.Seat" class="form-control" />
                        </div> *@

                        <div class="mb-3">
                            <label asp-for="Ticket.TimeMin" class="form-label">Время спектакля (в минутах)</label>
                            <input asp-for="Ticket.TimeMin" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ticket.DataShow" class="form-label">Дата показа</label>
                            <input asp-for="Ticket.DataShow" type="date" class="form-control" />
                            <span asp-validation-for="Ticket.DataShow" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ticket.Price" class="form-label">Цена</label>
                            <input asp-for="Ticket.Price" type="number" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-page="Index" class="btn btn-secondary">
                                Назад
                            </a>

                            <button type="submit" class="btn btn-success">
                                Сохранить
                            </button>

                        </div>

                    </form>
                     
                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}